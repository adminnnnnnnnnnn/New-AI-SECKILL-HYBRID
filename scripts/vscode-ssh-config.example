# ========================================
# VSCode Remote SSH 配置文件示例
# 将此配置添加到: C:\Users\你的用户名\.ssh\config
# ========================================

Host ai-seckill-server
    HostName YOUR_SERVER_IP          # 替换为你的腾讯云服务器IP
    User root
    Port 22
    # 如果使用密钥登录，取消下面这行的注释
    # IdentityFile C:\Users\你的用户名\.ssh\id_rsa
    ForwardAgent yes
    ServerAliveInterval 60
    ServerAliveCountMax 3

# 如果有多个服务器，可以继续添加
# Host production-server
#     HostName xxx.xxx.xxx.xxx
#     User ubuntu
#     Port 22
